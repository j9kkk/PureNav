# Runtime configuration. All values have sensible defaults; set only what you need.
PORT=8080
HOST=0.0.0.0
PURE_DATA_DIR=/data
PURE_WEB_DIST=/app/web-dist
PURE_SESSION_TTL_DAYS=7
LOG_LEVEL=info

# Set to 1 when the container sits behind a reverse proxy, so client IPs are read from X-Forwarded-*.
PURE_TRUST_PROXY=0

# Set to 1 to require HTTPS for the session cookie (recommended when exposed to the internet).
PURE_SECURE_COOKIE=0
